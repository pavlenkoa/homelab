<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.homelab.whisperkit-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/andrii/.local/opt/whisperkit-server/argmax-cli</string>
    <string>serve</string>
    <string>--model</string>
    <string>large-v3-v20240930_turbo</string>
    <!-- Loopback only: pods reach it via host.internal, LAN devices are refused. -->
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>50060</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/andrii/.local/opt/whisperkit-server</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/opt/homebrew/var/log/whisperkit-server.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/homebrew/var/log/whisperkit-server.log</string>
</dict>
</plist>
