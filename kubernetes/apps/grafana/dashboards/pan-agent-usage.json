    {
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "description": "Best-effort grouping done purely in Grafana (no pan-agent code change): chronological, one row per step. » = incoming request, « = assistant text, ⚙ = tool call (input truncated to 150 chars for display), ✓/✗ = turn finished (cost · steps · duration). No turn-id tag — a single person's turns never interleave with each other (single-flight session), so the person name plus chronological order is enough to follow a conversation; different people's turns do interleave with each other. `NO_UPDATE` (a scheduled-task sentinel meaning nothing was sent to Telegram) is rendered as a plain note instead of literal text. Still one row per step, not one block per turn — a true single-block view would need pan-agent itself to log a consolidated transcript.",
      "gridPos": { "h": 35, "w": 24, "x": 0, "y": 28 },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "showControls": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "unwrappedColumns": false,
        "wrapLogMessage": true
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "{namespace=\"pan-agent\"} | json | evt=~\"user|assistant|tool_use|turn_end\" | line_format `{{ if eq .evt \"user\" }}» {{ .person }}: {{ .text }}{{ else if eq .evt \"assistant\" }}{{ if eq .text \"NO_UPDATE\" }}« {{ .person }}: (nothing to report — no message sent){{ else }}« {{ .person }}: {{ .text }}{{ end }}{{ else if eq .evt \"tool_use\" }}   ⚙ {{ .tool }}: {{ .input | trunc 150 }}{{ else if eq .evt \"turn_end\" }}{{ if eq .ok \"true\" }}   ✓{{ else }}   ✗{{ end }} ${{ .cost_usd }} · {{ .turns }} step(s) · {{ .dur_ms }}ms{{ else }}{{ .person }}({{ .evt }}){{ end }}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent Turns",
      "type": "logs"
    }
